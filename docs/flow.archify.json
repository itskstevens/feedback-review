   "toCol": 1
  },
  {
   "id": "decide",
   "label": "You decide",
   "fromCol": 2,
   "toCol": 3,
   "variant": "emphasis"
  },
  {
   "id": "ship",
   "label": "Approve + apply",
   "fromCol": 4,
   "toCol": 5,
   "variant": "dashed"
