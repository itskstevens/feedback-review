   "variant": "emphasis"
  }
 ],
 "cards": [
  {
   "dot": "emerald",
   "title": "The four boxes",
   "items": [
    "New requirement: story updates go in after dev approval",
    "Future enhancement: one ticket, stories untouched",
    "Still needs discussion: nothing in Linear yet",
    "Already covered in app: Slack says what covers it"
   ]
  },
  {
   "dot": "cyan",
   "title": "Safe by default",
   "items": [
    "The scheduled run only reads and DMs you",
    "Nothing reaches your team or Linear until you press a button"
   ]
  }
 ]
